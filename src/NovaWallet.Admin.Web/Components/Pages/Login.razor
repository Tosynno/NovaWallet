@page "/login"
@layout NovaWallet.Admin.Web.Components.Layout.LoginLayout
@using NovaWallet.Admin.Web.Services
@inject AuthService Auth
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Login - NovaWallet Admin</PageTitle>

<div class="login-wrapper">
    <div class="login-split">
        <div class="login-brand-panel">
            <div class="d-flex align-items-center gap-2 mb-5">
                <div class="login-logo" style="margin:0;width:44px;height:44px;font-size:1.2rem;border-radius:10px">N</div>
                <span style="font-size:1.3rem;font-weight:800;color:#fff">Nova<span style="color:var(--nw-accent)">Wallet</span></span>
            </div>
            <h1>Admin Portal</h1>
            <p>Monitor transactions, review settlements, run reconciliation, and manage channels — all from one secure dashboard.</p>
            <ul class="login-brand-features">
                <li><span class="oi oi-shield"></span> Secure admin access with credential validation</li>
                <li><span class="oi oi-graph"></span> Real-time transaction monitoring & analytics</li>
                <li><span class="oi oi-scale"></span> End-of-day reconciliation & balancing</li>
                <li><span class="oi oi-key"></span> Channel & user management with KYC review</li>
            </ul>
            <div class="login-brand-footer">NovaWallet Ledger Service &copy; 2026. All rights reserved.</div>
        </div>
        <div class="login-form-panel">
            <div class="login-card">
                <div class="login-logo">N</div>
                <h3 class="login-title">Sign In</h3>
                <p class="login-subtitle">Enter your administrator credentials to continue</p>

                @if (ErrorMessage is not null)
                {
                    <div class="alert alert-danger mb-3 d-flex align-items-center gap-2">
                        <span class="oi oi-warning" style="font-size:1rem"></span>
                        <span>@ErrorMessage</span>
                    </div>
                }

                <EditForm Model="@LoginModel" FormName="admin-login" OnValidSubmit="@DoLogin">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small mb-2" />
                    <div class="login-field-group">
                        <label class="form-label">Username</label>
                        <span class="oi oi-person login-field-icon"></span>
                        <InputText class="form-control" placeholder="Enter username" @bind-Value="LoginModel.Username" autocomplete="username" />
                    </div>
                    <div class="login-field-group">
                        <label class="form-label">Password</label>
                        <span class="oi oi-lock login-field-icon"></span>
                        <InputText type="@(ShowPassword ? "text" : "password")" class="form-control" placeholder="Enter password" @bind-Value="LoginModel.Password" autocomplete="current-password" />
                        <button type="button" class="login-toggle-password" @onclick="@(() => ShowPassword = !ShowPassword)" aria-label="Toggle password visibility">
                            <span class="oi @(ShowPassword ? "oi-eye-open" : "oi-eye")"></span>
                        </button>
                    </div>
                    <div class="login-remember">
                        <label>
                            <input type="checkbox" @bind="RememberMe" />
                            <span>Remember me</span>
                        </label>
                        @* <a href="#" class="login-forgot">Forgot password?</a> *@
                    </div>
                    <button type="submit" class="btn btn-primary login-btn" disabled="@Loading">
                        @if (Loading)
                        {
                            <span class="spinner"></span>
                            <span class="ms-2">Signing in...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </button>
                </EditForm>

                <div class="login-divider">or</div>
                <p class="login-footer-text">
                    Protected by NovaWallet Security.<br />
                    Authorized personnel only.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginFormData LoginModel = new();
    private string? ErrorMessage;
    private bool Loading;
    private bool ShowPassword;
    private bool RememberMe;
    private string? ReturnUrl;

    protected override void OnInitialized()
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri);
        if (uri.StartsWith("login?returnUrl="))
        {
            var decoded = Uri.UnescapeDataString(uri["login?returnUrl=".Length..]);
            if (decoded.StartsWith('/') && !decoded.StartsWith("//"))
                ReturnUrl = decoded;
        }
    }

    private async Task DoLogin()
    {
        Loading = true;
        ErrorMessage = null;
        try
        {
            if (Auth.Validate(LoginModel.Username, LoginModel.Password))
            {
                Auth.SetAuthenticated(LoginModel.Username);
                AuthStateProvider.NotifyChanged();
                Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/dashboard" : ReturnUrl);
            }
            else
            {
                ErrorMessage = "Invalid username or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private sealed class LoginFormData
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Username is required")]
        [System.ComponentModel.DataAnnotations.MinLength(3, ErrorMessage = "Username must be at least 3 characters")]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = "";
    }
}
