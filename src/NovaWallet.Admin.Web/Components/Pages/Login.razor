@page "/login"
@using NovaWallet.Admin.Web.Services
@inject AuthService Auth
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Login - NovaWallet Admin</PageTitle>

<div class="container mt-5" style="max-width:400px">
    <h3 class="text-center mb-4">NovaWallet Admin</h3>
    @if (ErrorMessage is not null) { <div class="alert alert-danger">@ErrorMessage</div> }
    <EditForm Model="@LoginModel" OnValidSubmit="@DoLogin" class="card p-4 shadow-sm">
        <DataAnnotationsValidator />
        <div class="mb-3"><label class="form-label">App Key</label><InputText class="form-control" @bind-Value="LoginModel.AppKey" /></div>
        <div class="mb-3"><label class="form-label">App Secret</label><InputText type="password" class="form-control" @bind-Value="LoginModel.AppSecret" /></div>
        <button type="submit" class="btn btn-primary w-100" disabled="@Loading">@(Loading ? "Signing in..." : "Sign In")</button>
    </EditForm>
</div>

@code {
    private LoginFormData LoginModel = new();
    private string? ErrorMessage;
    private bool Loading;

    private async Task DoLogin()
    {
        Loading = true; ErrorMessage = null;
        try
        {
            var success = await Auth.LoginAsync(LoginModel.AppKey, LoginModel.AppSecret);
            if (success) { AuthStateProvider.NotifyChanged(); Nav.NavigateTo("/dashboard"); }
            else { ErrorMessage = "Invalid credentials."; }
        }
        catch (Exception ex) { ErrorMessage = $"Login failed: {ex.Message}"; }
        finally { Loading = false; }
    }

    private sealed class LoginFormData { [System.ComponentModel.DataAnnotations.Required] public string AppKey { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string AppSecret { get; set; } = ""; }
}
