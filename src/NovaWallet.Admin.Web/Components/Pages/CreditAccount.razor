@page "/credit-account"
@using NovaWallet.Admin.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AdminDatabaseService Db

<PageTitle>Credit Account - NovaWallet Admin</PageTitle>

<div class="container-fluid" style="max-width:640px">
    <h2>Credit Customer Account</h2>
    <hr />
    @if (ErrorMessage is not null) { <div class="alert alert-danger">@ErrorMessage</div> }
    @if (SuccessMessage is not null) { <div class="alert alert-success">@SuccessMessage</div> }
    <div class="card"><div class="card-body">
        <p class="text-muted">Credit a customer wallet directly. The amount is debited from the internal settlement account and mirrored to external holding accounts.</p>
        <div class="mb-3">
            <label class="form-label">Account Number</label>
            <input class="form-control monospace" placeholder="5000000000" @bind="AccountNumber" />
        </div>
        <div class="mb-3">
            <label class="form-label">Amount (Kobo)</label>
            <input type="number" class="form-control" placeholder="e.g. 1000000 for N 10,000" @bind="AmountKobo" />
        </div>
        <button class="btn btn-success" disabled="@Loading || string.IsNullOrWhiteSpace(AccountNumber) || AmountKobo <= 0" @onclick="DoCredit">
            @if (Loading) { <span class="spinner"></span> } else { <span class="oi oi-plus me-1"></span> }
            @(Loading ? " Processing..." : " Credit Account")
        </button>
    </div></div>

    @if (Result is not null)
    {
        <div class="card mt-3"><div class="card-body">
            <h5>Credit Successful</h5>
            <table class="table table-sm">
                <tr><td>Account Number</td><td class="monospace">@Result.AccountNumber</td></tr>
                <tr><td>Currency</td><td>@Result.Currency</td></tr>
                <tr><td>New Balance</td><td>@Result.Currency @((Result.BalanceKobo / 100m).ToString("N2"))</td></tr>
                <tr><td>Settlement Balance</td><td>NGN @((Result.SettlementBalanceKobo / 100m).ToString("N2"))</td></tr>
                <tr><td>Ledger Holding Balance</td><td>NGN @((Result.LedgerHoldingBalanceKobo / 100m).ToString("N2"))</td></tr>
            </table>
        </div></div>
    }
</div>

@code {
    private string AccountNumber = "";
    private long AmountKobo;
    private string? ErrorMessage, SuccessMessage;
    private bool Loading;
    private AdminDatabaseService.CreditResultDto? Result;

    private async Task DoCredit()
    {
        Loading = true; ErrorMessage = null; SuccessMessage = null; Result = null;
        try
        {
            var result = await Db.CreditAccountAsync(AccountNumber, AmountKobo, "ADMIN");
            if (result is not null)
            {
                Result = result;
                SuccessMessage = $"Account {result.AccountNumber} credited successfully with N {(AmountKobo / 100m):N2}.";
                AccountNumber = "";
                AmountKobo = 0;
            }
            else ErrorMessage = "Account not found or invalid amount.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { Loading = false; }
    }
}
