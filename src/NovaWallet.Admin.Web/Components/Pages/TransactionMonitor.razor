@page "/transactions"
@using NovaWallet.Admin.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AdminDatabaseService Db

<PageTitle>Transaction Monitor - NovaWallet Admin</PageTitle>

<div class="container-fluid">
    <h2>Transaction Monitor</h2>
    <hr />
    <div class="mb-3 d-flex gap-2">
        <div class="input-group" style="max-width:500px">
            <input class="form-control monospace" placeholder="Transfer ID (GUID)" @bind="TransferIdInput" />
            <button class="btn btn-outline-primary" @onclick="LookupTransfer"><span class="oi oi-search me-1"></span> Lookup</button>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadRecent"><span class="oi oi-list me-1"></span> Load Recent</button>
    </div>
    @if (ErrorMessage is not null) { <div class="alert alert-danger">@ErrorMessage</div> }

    @if (Transfer is not null)
    {
        <div class="card mb-3"><div class="card-body">
            <h5>Transfer Details</h5>
            <table class="table table-sm">
                <tr><th style="width:180px">Transfer ID</th><td><span class="monospace">@Transfer.Id</span></td></tr>
                <tr><th>Type</th><td><span class="badge bg-primary">@Transfer.Type</span></td></tr>
                <tr><th>Status</th><td><span class="badge @(Transfer.Status == "Settled" ? "bg-success" : Transfer.Status == "Failed" ? "bg-danger" : "bg-warning")">@Transfer.Status</span></td></tr>
                <tr><th>Amount (kobo)</th><td>@Transfer.AmountKobo</td></tr>
                <tr><th>Fee / VAT</th><td>@Transfer.FeeKobo / @Transfer.VatKobo</td></tr>
                <tr><th>Total Debit</th><td>@Transfer.TotalDebitKobo</td></tr>
                <tr><th>Reference</th><td><span class="monospace">@Transfer.Reference</span></td></tr>
                <tr><th>External Ref</th><td><span class="monospace">@(Transfer.ExternalReference ?? "-")</span></td></tr>
                <tr><th>Destination</th><td>@(Transfer.DestinationAccountNumber ?? "-") (@(Transfer.DestinationBankCode ?? "-"))</td></tr>
                <tr><th>Customer</th><td>@Transfer.CustomerId</td></tr>
                <tr><th>Created</th><td>@Transfer.CreatedAt</td></tr>
            </table>
        </div></div>
    }

    @if (RecentTransfers is not null)
    {
        <div class="card"><div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead><tr><th>ID</th><th>Type</th><th>Status</th><th>Amount</th><th>Customer</th><th>Reference</th><th>Created</th></tr></thead>
                <tbody>
                    @foreach (var t in RecentTransfers)
                    {
                        <tr><td><span class="monospace">@(t.Id.ToString()[..8])...</span></td><td><span class="badge bg-primary">@t.Type</span></td><td><span class="badge @(t.Status == "Settled" ? "bg-success" : t.Status == "Failed" ? "bg-danger" : "bg-warning")">@t.Status</span></td><td>@t.AmountKobo</td><td>@t.CustomerId</td><td class="monospace">@t.Reference</td><td class="text-muted small">@t.CreatedAt</td></tr>
                    }
                </tbody>
            </table>
        </div></div>
    }
</div>

@code {
    private string TransferIdInput = "";
    private AdminDatabaseService.TransferDto? Transfer;
    private List<AdminDatabaseService.TransferDto>? RecentTransfers;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync() => await LoadRecent();

    private async Task LookupTransfer()
    {
        if (!Guid.TryParse(TransferIdInput, out var id)) { ErrorMessage = "Invalid GUID"; return; }
        ErrorMessage = null;
        try { Transfer = await Db.GetTransferByIdAsync(id); RecentTransfers = null; }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private async Task LoadRecent()
    {
        try { RecentTransfers = await Db.GetRecentTransfersAsync(50); Transfer = null; ErrorMessage = null; }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }
}
