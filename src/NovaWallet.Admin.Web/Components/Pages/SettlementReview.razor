@page "/settlement"
@using NovaWallet.Admin.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api

<PageTitle>Settlement Review - NovaWallet Admin</PageTitle>

<div class="container mt-4">
    <h2>Settlement Review</h2>
    <hr />
    <p class="text-muted">Review settlement jobs and their status. Failed transfers can be reposted from the <a href="/repost">Repost Failed</a> page.</p>
    <div class="card">
        <div class="card-body">
            <h5>External Accounts (First Bank Holdings)</h5>
            @if (Accounts is not null)
            {
                <table class="table table-sm">
                    <thead><tr><th>Account Key</th><th>Bank</th><th>Account Number</th><th>Account Name</th><th>Balance (kobo)</th></tr></thead>
                    <tbody>
                        @foreach (var a in Accounts)
                        {
                            <tr><td>@a.AccountKey</td><td>@a.BankName</td><td>@a.AccountNumber</td><td>@a.AccountName</td><td>@a.BalanceKobo</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (Loading) { <p class="text-muted">Loading...</p> }
            else { <p class="text-muted">Click load to view external accounts.</p> }
            <button class="btn btn-outline-primary btn-sm" @onclick="LoadAccounts">Load Accounts</button>
        </div>
    </div>
</div>

@code {
    private List<ExternalAccountDto>? Accounts;
    private bool Loading;

    private async Task LoadAccounts()
    {
        Loading = true;
        try { Accounts = await Api.Http.GetFromJsonAsync<List<ExternalAccountDto>>("/api/v1/admin/external-accounts"); }
        catch { }
        finally { Loading = false; }
    }

    public sealed class ExternalAccountDto { public string AccountKey { get; set; } = ""; public string BankName { get; set; } = ""; public string AccountNumber { get; set; } = ""; public string AccountName { get; set; } = ""; public long BalanceKobo { get; set; } }
}
