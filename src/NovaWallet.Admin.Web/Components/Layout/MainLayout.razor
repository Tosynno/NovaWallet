@inherits LayoutComponentBase
@using NovaWallet.Admin.Web.Services
@inject AuthService Auth

<div class="page">
    <NavMenu />
    <main>
        <div class="top-row d-flex justify-content-between align-items-center">
            <span style="font-weight:700;color:var(--nw-primary)">Nova<span style="color:var(--nw-accent)">Wallet</span> Admin</span>
            @if (Auth.IsAuthenticated)
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small">@Auth.DisplayName</span>
                    <a href="/login" class="btn btn-outline-primary btn-sm" @onclick="@(() => { Auth.Logout(); })">Logout</a>
                </div>
            }
            else
            {
                <a href="/login" class="btn btn-primary btn-sm">Login</a>
            }
        </div>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" class="blazor-error-ui" style="display:none">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">X</a>
</div>
