{
  "Jwt": {
    "Issuer": "NovaWallet",
    "Audience": "NovaWallet.Public",
    "Key": "development-only-key-change-this-to-a-secret-store-value-1234567890"
  },
  "Swagger": {
    "Enabled": true,
    "RoutePrefix": "swagger",
    "Title": "NovaWallet Gateway API",
    "Description": "ProxyApi gateway - forwards to WalletApi. All endpoints require JWT.",
    "Version": "v1"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth-api",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "channels": {
        "ClusterId": "auth-api",
        "Match": {
          "Path": "/api/v1/channels/{**catch-all}"
        }
      },
      "users": {
        "ClusterId": "auth-api",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "wallet": {
        "ClusterId": "wallet-api",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-api": {
        "Destinations": {
          "auth": {
            "Address": "https://localhost:61540"
          }
        }
      },
      "wallet-api": {
        "Destinations": {
          "wallet": {
            "Address": "https://localhost:51077"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
