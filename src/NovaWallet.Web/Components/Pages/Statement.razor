@page "/statement"
@using NovaWallet.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api

<PageTitle>Statement - NovaWallet</PageTitle>

<div class="wallet-page">
    <div class="wallet-page-header">
        <h2>Transaction History</h2>
        <p>View all credits and debits on your wallet</p>
    </div>

    <div class="wallet-find-wallet">
        <p class="wallet-section-label"><span class="oi oi-wallet" style="font-size:0.8rem;margin-right:0.3rem"></span> Select Wallet</p>
        <div class="wallet-input-row">
            <select class="wallet-input" @bind="SelectedWalletId">
                <option value="">-- Select wallet --</option>
                @if (Wallets is not null)
                {
                    @foreach (var w in Wallets)
                    {
                        <option value="@w.Id">@w.AccountNumber</option>
                    }
                }
            </select>
            <button class="btn-primary-sm" @onclick="LoadStatement"><span class="oi oi-list me-1"></span> Load</button>
        </div>
    </div>

    @if (ErrorMessage is not null)
    {
        <div class="auth-alert-error mb-3">
            <span class="oi oi-warning" style="font-size:0.9rem"></span>
            <span>@ErrorMessage</span>
        </div>
    }

    @if (Items is not null && Items.Count > 0)
    {
        <div class="wallet-tx-summary">
            <div class="tx-summary-item">
                <p class="tx-summary-label">Total Transactions</p>
                <p class="tx-summary-value">@Items.Count</p>
            </div>
            <div class="tx-summary-divider"></div>
            <div class="tx-summary-item">
                <p class="tx-summary-label">Credits</p>
                <p class="tx-summary-value text-credit">@(Items.Count(x => x.Direction?.Equals("Credit", StringComparison.OrdinalIgnoreCase) == true))</p>
            </div>
            <div class="tx-summary-divider"></div>
            <div class="tx-summary-item">
                <p class="tx-summary-label">Debits</p>
                <p class="tx-summary-value text-debit">@(Items.Count(x => x.Direction?.Equals("Debit", StringComparison.OrdinalIgnoreCase) == true))</p>
            </div>
        </div>

        <div class="wallet-tx-list">
            @foreach (var item in Items)
            {
                var isDebit = item.Direction?.Equals("Debit", StringComparison.OrdinalIgnoreCase) == true;
                <div class="wallet-tx-item">
                    <div class="wallet-tx-icon @(isDebit ? "tx-debit" : "tx-credit")">
                        <span class="oi @(isDebit ? "oi-arrow-top" : "oi-arrow-bottom")"></span>
                    </div>
                    <div class="wallet-tx-info">
                        <p class="wallet-tx-title">@item.Leg</p>
                        <p class="wallet-tx-date">@item.CreatedAt.ToString("MMM dd, yyyy • HH:mm")</p>
                    </div>
                    <div class="wallet-tx-amount @(isDebit ? "text-debit" : "text-credit")">
                        @(isDebit ? "-" : "+") N @((item.AmountKobo / 100m).ToString("N2"))
                    </div>
                </div>
            }
        </div>

        <div class="wallet-pagination">
            <button class="btn-ghost-sm" disabled="@(Page <= 1)" @onclick='async () => { Page--; await LoadStatement(); }'>
                <span class="oi oi-chevron-left"></span> Previous
            </button>
            <span class="wallet-page-info">Page @Page</span>
            <button class="btn-ghost-sm" disabled="@(Items is null || Items.Count < PageSize)" @onclick='async () => { Page++; await LoadStatement(); }'>
                Next <span class="oi oi-chevron-right"></span>
            </button>
        </div>
    }
    else if (Items is not null && Items.Count == 0)
    {
        <div class="wallet-empty">
            <div class="wallet-empty-icon"><span class="oi oi-document"></span></div>
            <p>No transactions yet</p>
            <span>Make your first transfer to see it here</span>
            <a href="/transfer" class="btn-primary-sm mt-3"><span class="oi oi-transfer me-1"></span> New Transfer</a>
        </div>
    }
    else if (Loading)
    {
        <div class="wallet-loading">
            <span class="spinner" style="border-color:rgba(0,168,107,0.2);border-top-color:var(--nw-accent);width:28px;height:28px"></span>
            <p>Loading transactions...</p>
        </div>
    }
    else
    {
        <div class="wallet-empty">
            <div class="wallet-empty-icon"><span class="oi oi-list"></span></div>
            <p>Select a wallet to view transactions</p>
        </div>
    }
</div>

@code {
    private string SelectedWalletId = "";
    private int Page = 1;
    private int PageSize = 25;
    private List<StatementItem>? Items;
    private List<WalletItem>? Wallets;
    private bool Loading;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        Wallets = await Api.GetAsync<List<WalletItem>>("/api/v1/wallets");
    }

    private async Task LoadStatement()
    {
        if (string.IsNullOrWhiteSpace(SelectedWalletId)) { ErrorMessage = "Please select a wallet."; return; }
        if (!Guid.TryParse(SelectedWalletId, out var id)) { ErrorMessage = "Invalid wallet ID."; return; }
        ErrorMessage = null; Loading = true;
        try { Items = await Api.GetAsync<List<StatementItem>>($"/api/v1/wallets/{id}/transactions?page={Page}&pageSize={PageSize}"); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { Loading = false; }
    }

    public sealed class WalletItem { public Guid Id { get; set; } public string AccountNumber { get; set; } = ""; public string AccountName { get; set; } = ""; public long BalanceKobo { get; set; } }
    public sealed class StatementItem { public Guid? TransferId { get; set; } public string Direction { get; set; } = ""; public long AmountKobo { get; set; } public string Leg { get; set; } = ""; public DateTime CreatedAt { get; set; } }
}
