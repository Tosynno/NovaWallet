@page "/statement"
@using NovaWallet.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api

<PageTitle>Statement - NovaWallet</PageTitle>

<div class="container-fluid">
    <h2>Transaction Statement</h2>
    <hr />
    <div class="card mb-3"><div class="card-body">
        <div class="d-flex gap-3 align-items-end flex-wrap">
            <div class="flex-grow-1" style="min-width:280px">
                <label class="form-label">Wallet ID</label>
                <input class="form-control monospace" placeholder="00000000-0000-0000-0000-000000000000" @bind="WalletIdInput" />
            </div>
            <div><label class="form-label">Page</label><input type="number" class="form-control" style="width:90px" @bind="Page" /></div>
            <div><label class="form-label">Size</label><input type="number" class="form-control" style="width:90px" @bind="PageSize" /></div>
            <button class="btn btn-primary" @onclick="LoadStatement"><span class="oi oi-list me-1"></span> Load</button>
        </div>
    </div></div>

    @if (Items is not null)
    {
        <div class="card"><div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead><tr><th>Transfer ID</th><th>Direction</th><th>Amount (kobo)</th><th>Leg</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        <tr>
                            <td><span class="monospace">@(item.TransferId?.ToString()[..8] + "...")</span></td>
                            <td><span class="badge @(item.Direction == "Debit" ? "bg-danger" : "bg-success")">@item.Direction</span></td>
                            <td>@item.AmountKobo</td>
                            <td>@item.Leg</td>
                            <td class="text-muted small">@item.CreatedAt</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
        <div class="d-flex gap-2 mt-3 justify-content-center align-items-center">
            <button class="btn btn-outline-primary btn-sm" disabled="@(Page <= 1)" @onclick='async () => { Page--; await LoadStatement(); }'><span class="oi oi-chevron-left"></span> Previous</button>
            <span class="text-muted small">Page @Page</span>
            <button class="btn btn-outline-primary btn-sm" disabled="@(Items is null || Items.Count < PageSize)" @onclick='async () => { Page++; await LoadStatement(); }'>Next <span class="oi oi-chevron-right"></span></button>
        </div>
    }
    @if (ErrorMessage is not null) { <div class="alert alert-danger mt-2">@ErrorMessage</div> }
</div>

@code {
    private string WalletIdInput = "";
    private int Page = 1;
    private int PageSize = 25;
    private List<StatementItem>? Items;
    private string? ErrorMessage;

    private async Task LoadStatement()
    {
        if (!Guid.TryParse(WalletIdInput, out var id)) { ErrorMessage = "Invalid Wallet ID"; return; }
        ErrorMessage = null;
        try { Items = await Api.GetAsync<List<StatementItem>>($"/api/v1/wallets/{id}/transactions?page={Page}&pageSize={PageSize}"); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    public sealed class StatementItem { public Guid? TransferId { get; set; } public string Direction { get; set; } = ""; public long AmountKobo { get; set; } public string Leg { get; set; } = ""; public DateTime CreatedAt { get; set; } }
}
