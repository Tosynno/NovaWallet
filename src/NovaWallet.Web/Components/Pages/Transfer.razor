@page "/transfer"
@using NovaWallet.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api

<PageTitle>Transfer - NovaWallet</PageTitle>

<div class="container-fluid" style="max-width:680px">
    <h2>New Transfer</h2>
    <hr />
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(Tab == "internal" ? "active" : "")" @onclick='() => Tab = "internal"'>Internal (N2N)</button></li>
        <li class="nav-item"><button class="nav-link @(Tab == "outbound" ? "active" : "")" @onclick='() => Tab = "outbound"'>Outbound (Other Bank)</button></li>
    </ul>

    @if (ErrorMessage is not null) { <div class="alert alert-danger">@ErrorMessage</div> }
    @if (SuccessMessage is not null) { <div class="alert alert-success">@SuccessMessage</div> }

    @if (Tab == "internal")
    {
        <div class="card"><div class="card-body">
            <div class="mb-3"><label class="form-label">Source Wallet ID</label><input class="form-control monospace" placeholder="00000000-0000-0000-0000-000000000000" @bind="InternalModel.SourceWalletId" /></div>
            <div class="mb-3"><label class="form-label">Destination Account Number</label><input class="form-control" placeholder="9000000001" @bind="InternalModel.DestinationAccountNumber" /></div>
            <div class="mb-3"><label class="form-label">Amount (kobo)</label><input type="number" class="form-control" placeholder="100000" @bind="InternalModel.AmountKobo" /></div>
            <div class="mb-3"><label class="form-label">Idempotency Key</label><input class="form-control monospace" @bind="IdempotencyKey" /></div>
            <button class="btn btn-primary w-100" style="padding:0.7rem" disabled="@Loading" @onclick="DoInternal">
                @if (Loading) { <span class="spinner"></span> <span class="ms-2">Processing...</span> } else { <span class="oi oi-transfer me-2"></span><span>Send Transfer</span> }
            </button>
        </div></div>
    }
    else
    {
        <div class="card"><div class="card-body">
            <div class="mb-3"><label class="form-label">Source Wallet ID</label><input class="form-control monospace" placeholder="00000000-0000-0000-0000-000000000000" @bind="OutboundModel.SourceWalletId" /></div>
            <div class="mb-3"><label class="form-label">Destination Account Number</label><input class="form-control" placeholder="0123456789" @bind="OutboundModel.DestinationAccountNumber" /></div>
            <div class="mb-3"><label class="form-label">Destination Bank Code</label><input class="form-control" placeholder="058" @bind="OutboundModel.DestinationBankCode" /></div>
            <div class="mb-3"><label class="form-label">Destination Account Name</label><input class="form-control" placeholder="Jane Doe" @bind="OutboundModel.DestinationAccountName" /></div>
            <div class="mb-3"><label class="form-label">Amount (kobo)</label><input type="number" class="form-control" placeholder="100000" @bind="OutboundModel.AmountKobo" /></div>
            <div class="mb-3"><label class="form-label">Idempotency Key</label><input class="form-control monospace" @bind="IdempotencyKey" /></div>
            <button class="btn btn-primary w-100" style="padding:0.7rem" disabled="@Loading" @onclick="DoOutbound">
                @if (Loading) { <span class="spinner"></span> <span class="ms-2">Processing...</span> } else { <span class="oi oi-share me-2"></span><span>Send Outbound</span> }
            </button>
        </div></div>
    }
</div>

@code {
    private string Tab = "internal";
    private string? ErrorMessage, SuccessMessage;
    private bool Loading;
    private string IdempotencyKey = Guid.NewGuid().ToString("N");
    private InternalTransferModel InternalModel = new();
    private OutboundTransferModel OutboundModel = new();

    private async Task DoInternal()
    {
        Loading = true; ErrorMessage = null; SuccessMessage = null;
        try
        {
            var req = new { SourceWalletId = InternalModel.SourceWalletId, DestinationAccountNumber = InternalModel.DestinationAccountNumber, AmountKobo = InternalModel.AmountKobo };
            var result = await Api.PostAsync<TransferResponse>("/api/v1/transfers/internal", req);
            if (result is not null) { SuccessMessage = $"Transfer successful. Ref: {result.Reference}"; IdempotencyKey = Guid.NewGuid().ToString("N"); }
            else ErrorMessage = "Transfer failed. Check your inputs.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { Loading = false; }
    }

    private async Task DoOutbound()
    {
        Loading = true; ErrorMessage = null; SuccessMessage = null;
        try
        {
            var req = new { SourceWalletId = OutboundModel.SourceWalletId, DestinationAccountNumber = OutboundModel.DestinationAccountNumber, DestinationBankCode = OutboundModel.DestinationBankCode, DestinationAccountName = OutboundModel.DestinationAccountName, AmountKobo = OutboundModel.AmountKobo };
            var result = await Api.PostAsync<TransferResponse>("/api/v1/transfers/outbound", req);
            if (result is not null) { SuccessMessage = $"Outbound submitted. Ref: {result.Reference}"; IdempotencyKey = Guid.NewGuid().ToString("N"); }
            else ErrorMessage = "Transfer failed. Check your inputs.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { Loading = false; }
    }

    public sealed class InternalTransferModel { public string SourceWalletId { get; set; } = ""; public string DestinationAccountNumber { get; set; } = ""; public long AmountKobo { get; set; } }
    public sealed class OutboundTransferModel { public string SourceWalletId { get; set; } = ""; public string DestinationAccountNumber { get; set; } = ""; public string DestinationBankCode { get; set; } = ""; public string DestinationAccountName { get; set; } = ""; public long AmountKobo { get; set; } }
    public sealed class TransferResponse { public Guid TransferId { get; set; } public string Reference { get; set; } = ""; }
}
