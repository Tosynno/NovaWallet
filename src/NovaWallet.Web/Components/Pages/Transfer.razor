@page "/transfer"
@using NovaWallet.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ApiClient Api

<PageTitle>Transfer - NovaWallet</PageTitle>

<div class="wallet-page" style="max-width:680px">
    <div class="wallet-page-header">
        <h2>Send Money</h2>
        <p>Transfer to NovaWallet accounts or any Nigerian bank</p>
    </div>

    <div class="wallet-transfer-tabs">
        <button class="wallet-tab @(Tab == "internal" ? "active" : "")" @onclick='() => Tab = "internal"'>
            <span class="oi oi-transfer"></span> To NovaWallet
        </button>
        <button class="wallet-tab @(Tab == "outbound" ? "active" : "")" @onclick='() => Tab = "outbound"'>
            <span class="oi oi-share"></span> To Other Bank
        </button>
    </div>

    @if (ErrorMessage is not null)
    {
        <div class="auth-alert-error mb-3">
            <span class="oi oi-warning" style="font-size:0.9rem"></span>
            <span>@ErrorMessage</span>
        </div>
    }
    @if (SuccessMessage is not null)
    {
        <div class="wallet-success-banner mb-3">
            <span class="oi oi-check-circle" style="font-size:1.1rem"></span>
            <div>
                <strong>Transfer Successful</strong>
                <p>@SuccessMessage</p>
            </div>
        </div>
    }

    <div class="wallet-form-card">
        <div class="wallet-field">
            <label>From Wallet</label>
            @if (Wallets is null || Wallets.Count == 0)
            {
                <div class="wallet-no-wallets">
                    <span class="oi oi-wallet"></span>
                    <p>No wallet found. Your wallet is created automatically at registration.</p>
                </div>
            }
            else
            {
                <select class="wallet-input wallet-select" value="@SelectedWalletId" @onchange="OnWalletChanged">
                    <option value="">-- Select wallet --</option>
                    @foreach (var w in Wallets)
                    {
                        <option value="@w.Id">@w.AccountNumber (N @((w.BalanceKobo / 100m).ToString("N2")))</option>
                    }
                </select>
                @if (SelectedBalanceKobo > 0)
                {
                    <p class="wallet-field-hint">Available balance: N @((SelectedBalanceKobo / 100m).ToString("N2"))</p>
                }
            }
        </div>

        @if (Tab == "internal")
        {
            <div class="wallet-field">
                <label>Destination Account Number</label>
                <div class="auth-input-wrap">
                    <span class="oi oi-person auth-input-icon"></span>
                    <input class="wallet-input auth-input" placeholder="Enter 10-digit NovaWallet account number" @bind="InternalModel.DestinationAccountNumber" />
                </div>
                <div class="wallet-verify-row">
                    <button class="btn-primary-sm" @onclick="VerifyAccount" disabled="@Verifying">
                        @if (Verifying) { <span class="spinner" style="border-color:rgba(0,168,107,0.3);border-top-color:var(--nw-accent)"></span> }
                        else { <span class="oi oi-check me-1"></span> }
                        @(Verifying ? "Verifying..." : "Verify Account")
                    </button>
                    @if (VerifiedAccountName is not null)
                    {
                        <div class="wallet-verified-account">
                            <span class="oi oi-check-circle"></span>
                            <div>
                                <p class="verified-label">Account Verified</p>
                                <p class="verified-name">@VerifiedAccountName</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="wallet-field">
                <label>Amount</label>
                <div class="wallet-amount-input">
                    <span class="wallet-currency">N</span>
                    <input type="number" class="wallet-input" placeholder="0.00" @bind="InternalModel.AmountKobo" />
                </div>
                <p class="wallet-field-hint">Internal transfers are free — no fees applied</p>
                @if (SelectedBalanceKobo > 0 && InternalModel.AmountKobo > 0)
                {
                    <div class="wallet-balance-preview">
                        <div><span>Wallet balance</span><strong>N @((SelectedBalanceKobo / 100m).ToString("N2"))</strong></div>
                        <div><span>After transfer</span><strong class="@(SelectedBalanceKobo - InternalModel.AmountKobo < 0 ? "text-debit" : "text-credit")">N @(((SelectedBalanceKobo - InternalModel.AmountKobo) / 100m).ToString("N2"))</strong></div>
                    </div>
                    @if (InternalModel.AmountKobo > SelectedBalanceKobo)
                    {
                        <p class="wallet-error"><span class="oi oi-warning" style="font-size:0.8rem"></span> Insufficient balance for this transfer</p>
                    }
                }
            </div>
            <button class="btn-primary-lg w-100" disabled="@Loading || InternalModel.AmountKobo > SelectedBalanceKobo || string.IsNullOrWhiteSpace(SelectedWalletId) || string.IsNullOrWhiteSpace(VerifiedAccountName)" @onclick="DoInternal">
                @if (Loading) { <span class="spinner"></span> <span class="ms-2">Processing...</span> } else { <span class="oi oi-transfer me-2"></span><span>Send Transfer</span> }
            </button>
        }
        else
        {
            <div class="wallet-field-row">
                <div class="wallet-field">
                    <label>Account Number</label>
                    <div class="auth-input-wrap">
                        <span class="oi oi-person auth-input-icon"></span>
                        <input class="wallet-input auth-input" placeholder="0123456789" @bind="OutboundModel.DestinationAccountNumber" />
                    </div>
                </div>
                <div class="wallet-field">
                    <label>Bank Code</label>
                    <div class="auth-input-wrap">
                        <span class="oi oi-bank auth-input-icon"></span>
                        <input class="wallet-input auth-input" placeholder="058" @bind="OutboundModel.DestinationBankCode" />
                    </div>
                </div>
            </div>
            <div class="wallet-field">
                <label>Account Name</label>
                <div class="auth-input-wrap">
                    <span class="oi oi-person auth-input-icon"></span>
                    <input class="wallet-input auth-input" placeholder="Jane Doe" @bind="OutboundModel.DestinationAccountName" />
                </div>
            </div>
            <div class="wallet-field">
                <label>Amount</label>
                <div class="wallet-amount-input">
                    <span class="wallet-currency">N</span>
                    <input type="number" class="wallet-input" placeholder="0.00" @bind="OutboundModel.AmountKobo" />
                </div>
                <div class="wallet-fee-hint">
                    <span class="oi oi-info"></span>
                    <p>A transfer fee of N 500.00 and 7.5% VAT applies to outbound transfers</p>
                </div>
                @if (SelectedBalanceKobo > 0 && OutboundModel.AmountKobo > 0)
                {
                    var totalDebit = OutboundModel.AmountKobo + 50_000 + 3_750;
                    <div class="wallet-balance-preview">
                        <div><span>Wallet balance</span><strong>N @((SelectedBalanceKobo / 100m).ToString("N2"))</strong></div>
                        <div><span>Total debit (amount + fee + VAT)</span><strong>N @((totalDebit / 100m).ToString("N2"))</strong></div>
                    </div>
                    @if (totalDebit > SelectedBalanceKobo)
                    {
                        <p class="wallet-error"><span class="oi oi-warning" style="font-size:0.8rem"></span> Insufficient balance for this transfer</p>
                    }
                }
            </div>
            <button class="btn-primary-lg w-100" disabled="@Loading || OutboundModel.AmountKobo <= 0 || (SelectedBalanceKobo > 0 && OutboundModel.AmountKobo + 50_000 + 3_750 > SelectedBalanceKobo) || string.IsNullOrWhiteSpace(SelectedWalletId)" @onclick="DoOutbound">
                @if (Loading) { <span class="spinner"></span> <span class="ms-2">Processing...</span> } else { <span class="oi oi-share me-2"></span><span>Send to Bank</span> }
            </button>
        }
    </div>
</div>

@code {
    private string Tab = "internal";
    private string? ErrorMessage, SuccessMessage;
    private bool Loading, Verifying;
    private string IdempotencyKey = Guid.NewGuid().ToString("N");
    private string _selectedWalletId = "";
    private string? VerifiedAccountName;
    private List<WalletItem>? Wallets;
    private long SelectedBalanceKobo;

    private string SelectedWalletId
    {
        get => _selectedWalletId;
        set
        {
            _selectedWalletId = value;
            var wallet = Wallets?.FirstOrDefault(x => x.Id.ToString() == value);
            SelectedBalanceKobo = wallet?.BalanceKobo ?? 0;
            VerifiedAccountName = null;
        }
    }

    private InternalTransferModel InternalModel = new();
    private OutboundTransferModel OutboundModel = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Wallets = await Api.GetAsync<List<WalletItem>>("/api/v1/wallets");
        }
        catch { }
    }

    private void OnWalletChanged(ChangeEventArgs e)
    {
        SelectedWalletId = e?.Value?.ToString() ?? "";
    }

    private async Task VerifyAccount()
    {
        if (string.IsNullOrWhiteSpace(InternalModel.DestinationAccountNumber)) return;
        Verifying = true; VerifiedAccountName = null; ErrorMessage = null;
        try
        {
            var result = await Api.GetAsync<NameEnquiryResponse>($"/api/v1/name-enquiry/{InternalModel.DestinationAccountNumber}");
            if (result is not null)
                VerifiedAccountName = result.AccountName;
            else
                ErrorMessage = "Account not found. Please check the account number.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { Verifying = false; }
    }

    private async Task DoInternal()
    {
        if (string.IsNullOrWhiteSpace(SelectedWalletId)) { ErrorMessage = "Please select a source wallet."; return; }
        if (string.IsNullOrWhiteSpace(VerifiedAccountName)) { ErrorMessage = "Please verify the destination account first."; return; }
        if (InternalModel.AmountKobo <= 0) { ErrorMessage = "Please enter a valid amount."; return; }
        if (InternalModel.AmountKobo > SelectedBalanceKobo) { ErrorMessage = "Insufficient wallet balance."; return; }

        Loading = true; ErrorMessage = null; SuccessMessage = null;
        try
        {
            var req = new { SourceWalletId = SelectedWalletId, DestinationAccountNumber = InternalModel.DestinationAccountNumber, AmountKobo = InternalModel.AmountKobo };
            var result = await Api.PostAsync<TransferResponse>("/api/v1/transfers/internal", req, IdempotencyKey);
            if (result is not null) { SuccessMessage = $"Reference: {result.Reference}"; IdempotencyKey = Guid.NewGuid().ToString("N"); VerifiedAccountName = null; }
            else ErrorMessage = "Transfer failed. Please try again.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { Loading = false; }
    }

    private async Task DoOutbound()
    {
        if (string.IsNullOrWhiteSpace(SelectedWalletId)) { ErrorMessage = "Please select a source wallet."; return; }
        if (OutboundModel.AmountKobo <= 0) { ErrorMessage = "Please enter a valid amount."; return; }
        var totalDebit = OutboundModel.AmountKobo + 50_000 + 3_750;
        if (totalDebit > SelectedBalanceKobo) { ErrorMessage = "Insufficient wallet balance for amount + fee + VAT."; return; }

        Loading = true; ErrorMessage = null; SuccessMessage = null;
        try
        {
            var req = new { SourceWalletId = SelectedWalletId, DestinationAccountNumber = OutboundModel.DestinationAccountNumber, DestinationBankCode = OutboundModel.DestinationBankCode, DestinationAccountName = OutboundModel.DestinationAccountName, AmountKobo = OutboundModel.AmountKobo };
            var result = await Api.PostAsync<TransferResponse>("/api/v1/transfers/outbound", req, IdempotencyKey);
            if (result is not null) { SuccessMessage = $"Reference: {result.Reference}"; IdempotencyKey = Guid.NewGuid().ToString("N"); }
            else ErrorMessage = "Transfer failed. Please try again.";
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { Loading = false; }
    }

    public sealed class WalletItem { public Guid Id { get; set; } public string AccountNumber { get; set; } = ""; public string AccountName { get; set; } = ""; public long BalanceKobo { get; set; } }
    public sealed class NameEnquiryResponse { public string AccountNumber { get; set; } = ""; public string AccountName { get; set; } = ""; public string BankCode { get; set; } = ""; public string BankName { get; set; } = ""; }
    public sealed class InternalTransferModel { public string DestinationAccountNumber { get; set; } = ""; public long AmountKobo { get; set; } }
    public sealed class OutboundTransferModel { public string DestinationAccountNumber { get; set; } = ""; public string DestinationBankCode { get; set; } = ""; public string DestinationAccountName { get; set; } = ""; public long AmountKobo { get; set; } }
    public sealed class TransferResponse { public Guid TransferId { get; set; } public string Reference { get; set; } = ""; }
}
