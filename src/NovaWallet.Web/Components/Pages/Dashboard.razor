@page "/dashboard"
@using NovaWallet.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AuthService Auth
@inject ApiClient Api

<PageTitle>Dashboard - NovaWallet</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Welcome back</h2>
            <p class="text-muted mb-0" style="font-size:0.9rem">@Auth.ChannelKey</p>
        </div>
        <a href="/transfer" class="btn btn-primary"><span class="oi oi-transfer me-1"></span> New Transfer</a>
    </div>
    <hr />
    <div class="row g-3 mt-1">
        <div class="col-md-7">
            <div class="card" style="border-left:4px solid var(--nw-accent)">
                <div class="card-body">
                    <h5>Wallet Balance</h5>
                    @if (Balance is not null)
                    {
                        <p class="display-6 text-success mb-1">@((Balance.BalanceKobo / 100m).ToString("N2"))</p>
                        <p class="text-muted small mb-3">Account: <span class="monospace">@Balance.AccountNumber</span> | Currency: @Balance.Currency</p>
                        <button class="btn btn-outline-primary btn-sm" @onclick="LoadBalance"><span class="oi oi-reload me-1"></span> Refresh</button>
                    }
                    else if (LoadingBalance)
                    {
                        <p class="loading-text">Loading balance...</p>
                    }
                    else
                    {
                        <p class="text-muted mb-3">Enter your Wallet ID to view balance.</p>
                        <div class="input-group" style="max-width:400px">
                            <input class="form-control" placeholder="Wallet ID (GUID)" @bind="WalletIdInput" />
                            <button class="btn btn-primary" @onclick="LoadBalance"><span class="oi oi-check"></span> Check</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h5 class="mb-3">Quick Actions</h5>
                    <div class="d-grid gap-2">
                        <a href="/transfer" class="btn btn-primary"><span class="oi oi-transfer me-2"></span> New Transfer</a>
                        <a href="/statement" class="btn btn-outline-primary"><span class="oi oi-list me-2"></span> View Statement</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string WalletIdInput = "";
    private BalanceResponse? Balance;
    private bool LoadingBalance;

    private async Task LoadBalance()
    {
        if (!Guid.TryParse(WalletIdInput, out var id)) return;
        LoadingBalance = true;
        try { Balance = await Api.GetAsync<BalanceResponse>($"/api/v1/wallets/{id}/balance"); }
        catch { }
        finally { LoadingBalance = false; }
    }

    public sealed class BalanceResponse { public string AccountNumber { get; set; } = ""; public string Currency { get; set; } = ""; public long BalanceKobo { get; set; } }
}
