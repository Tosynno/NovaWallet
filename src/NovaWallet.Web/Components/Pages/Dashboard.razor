@page "/dashboard"
@using NovaWallet.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AuthService Auth
@inject ApiClient Api

<PageTitle>Dashboard - NovaWallet</PageTitle>

<div class="wallet-page">
    <div class="wallet-balance-card">
        <div class="wallet-balance-sheen"></div>
        <div class="wallet-balance-top">
            <div>
                <p class="wallet-balance-label">Available Balance</p>
                @if (LoadingWallets)
                {
                    <h1 class="wallet-balance-amount"><span class="spinner" style="border-color:rgba(255,255,255,0.3);border-top-color:#fff"></span></h1>
                    <p class="wallet-account-number">Loading...</p>
                }
                else if (SelectedWallet is not null)
                {
                    <h1 class="wallet-balance-amount">@((SelectedWallet.BalanceKobo / 100m).ToString("N2"))</h1>
                    <p class="wallet-account-number">
                        <span class="oi oi-check-circle"></span> @SelectedWallet.AccountNumber
                    </p>
                }
                else
                {
                    <h1 class="wallet-balance-amount">0.00</h1>
                    <p class="wallet-account-number">No wallet found</p>
                }
            </div>
            <div class="wallet-balance-badge">
                <span class="oi oi-shield"></span>
            </div>
        </div>
        <div class="wallet-balance-actions">
            <a href="/transfer" class="wallet-quick-action">
                <div class="wallet-quick-icon"><span class="oi oi-transfer"></span></div>
                <p>Transfer</p>
            </a>
            <a href="/create-account" class="wallet-quick-action">
                <div class="wallet-quick-icon"><span class="oi oi-plus"></span></div>
                <p>New Account</p>
            </a>
            <a href="/statement" class="wallet-quick-action">
                <div class="wallet-quick-icon"><span class="oi oi-list"></span></div>
                <p>History</p>
            </a>
            <button class="wallet-quick-action" @onclick="LoadWallets">
                <div class="wallet-quick-icon"><span class="oi oi-reload"></span></div>
                <p>Refresh</p>
            </button>
        </div>
    </div>

    @if (ErrorMessage is not null)
    {
        <div class="auth-alert-error mb-3">
            <span class="oi oi-warning" style="font-size:0.9rem"></span>
            <span>@ErrorMessage</span>
        </div>
    }

    @if (Wallets is not null && Wallets.Count > 0)
    {
        <div class="wallet-section">
            <div class="wallet-section-header">
                <h3>Your Account(s)</h3>
                <p>Select an account to view balance or make transfers</p>
            </div>
            <div class="wallet-list">
                @foreach (var wallet in Wallets)
                {
                    <div class="wallet-list-item @(SelectedWallet?.Id == wallet.Id ? "selected" : "")" @onclick="() => SelectWallet(wallet)">
                        <div class="wallet-list-icon">
                            <span class="oi oi-wallet"></span>
                        </div>
                        <div class="wallet-list-info">
                            <p class="wallet-list-number">@wallet.AccountNumber</p>
                            <p class="wallet-list-name">@(string.IsNullOrWhiteSpace(wallet.AccountName) ? "Primary Account" : wallet.AccountName)</p>
                            <p class="wallet-list-balance">@wallet.Currency @((wallet.BalanceKobo / 100m).ToString("N2"))</p>
                        </div>
                        @if (SelectedWallet?.Id == wallet.Id)
                        {
                            <div class="wallet-list-check"><span class="oi oi-check"></span></div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (!LoadingWallets && Wallets is not null)
    {
        <div class="wallet-empty">
            <div class="wallet-empty-icon"><span class="oi oi-wallet"></span></div>
            <p>No account found</p>
            <span>Your wallet was created when you registered. If you don't see it, try refreshing.</span>
            <button class="btn-primary-sm mt-3" @onclick="LoadWallets"><span class="oi oi-reload me-1"></span> Refresh</button>
        </div>
    }

    <div class="wallet-section">
        <div class="wallet-section-header">
            <h3>Quick Actions</h3>
        </div>
        <div class="wallet-action-grid">
            <a href="/transfer" class="wallet-action-card wallet-action-blue">
                <div class="wallet-action-icon"><span class="oi oi-transfer"></span></div>
                <p>Transfer</p>
                <span>Send to NovaWallet</span>
            </a>
            <a href="/kyc" class="wallet-action-card wallet-action-green">
                <div class="wallet-action-icon"><span class="oi oi-shield"></span></div>
                <p>KYC</p>
                <span>Increase limits</span>
            </a>
            <a href="/statement" class="wallet-action-card wallet-action-orange">
                <div class="wallet-action-icon"><span class="oi oi-list"></span></div>
                <p>Statement</p>
                <span>View history</span>
            </a>
            <a href="/transfer" class="wallet-action-card wallet-action-purple">
                <div class="wallet-action-icon"><span class="oi oi-share"></span></div>
                <p>Outbound</p>
                <span>Other banks</span>
            </a>
        </div>
    </div>

    <div class="wallet-hint-card">
        <span class="oi oi-info wallet-hint-icon"></span>
        <p>Your account number was created automatically when you registered. All NovaWallet account numbers start with 50.</p>
    </div>
</div>

@code {
    private List<WalletItem>? Wallets;
    private WalletItem? SelectedWallet;
    private bool LoadingWallets;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync() => await LoadWallets();

    private async Task LoadWallets()
    {
        LoadingWallets = true; ErrorMessage = null;
        try
        {
            Wallets = await Api.GetAsync<List<WalletItem>>("/api/v1/wallets");
            if (Wallets is not null && Wallets.Count > 0)
                SelectWallet(Wallets[0]);
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { LoadingWallets = false; }
    }

    private void SelectWallet(WalletItem wallet) => SelectedWallet = wallet;

    public sealed class WalletItem { public Guid Id { get; set; } public string AccountNumber { get; set; } = ""; public string Currency { get; set; } = ""; public string AccountName { get; set; } = ""; public long BalanceKobo { get; set; } }
}
