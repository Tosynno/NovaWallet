@page "/"
@using NovaWallet.Web.Services
@inject NavigationManager Nav
@inject AuthService Auth

<PageTitle>NovaWallet</PageTitle>

<div class="container text-center mt-5">
    <h1>NovaWallet</h1>
    <p class="lead">Simplified wallet ledger for the Nigerian fintech ecosystem.</p>
    <a href="/login" class="btn btn-primary btn-lg mt-3">Get Started</a>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.NavigateTo(Auth.IsAuthenticated ? "/dashboard" : "/login");
    }
}
