@page "/login"
@layout NovaWallet.Web.Components.Layout.AuthLayout
@using NovaWallet.Web.Services
@inject AuthService Auth
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Login - NovaWallet</PageTitle>

<div class="auth-form-card">
    <div class="auth-form-header">
        <h2>Welcome back</h2>
        <p>Sign in to your NovaWallet account</p>
    </div>
    @if (ErrorMessage is not null)
    {
        <div class="auth-alert-error">
            <span class="oi oi-warning" style="font-size:0.9rem"></span>
            <span>@ErrorMessage</span>
        </div>
    }
    <EditForm Model="@LoginModel" FormName="customer-login" OnValidSubmit="@DoLogin">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger small mb-2" />
        <div class="auth-field">
            <label>Email Address</label>
            <div class="auth-input-wrap">
                <span class="oi oi-envelope auth-input-icon"></span>
                <InputText class="form-control auth-input" placeholder="you@example.com" @bind-Value="LoginModel.Email" autocomplete="username" />
            </div>
        </div>
        <div class="auth-field">
            <label>Password</label>
            <div class="auth-input-wrap">
                <span class="oi oi-lock auth-input-icon"></span>
                <InputText type="@(ShowPassword ? "text" : "password")" class="form-control auth-input" placeholder="Enter password" @bind-Value="LoginModel.Password" autocomplete="current-password" />
                <button type="button" class="auth-input-toggle" @onclick="@(() => ShowPassword = !ShowPassword)" aria-label="Toggle password">
                    <span class="oi @(ShowPassword ? "oi-eye-open" : "oi-eye")"></span>
                </button>
            </div>
        </div>
        <button type="submit" class="btn-primary-lg w-100" disabled="@Loading">
            @if (Loading) { <span class="spinner"></span> <span class="ms-2">Signing in...</span> } else { <span>Sign In</span> <span class="oi oi-arrow-right" style="font-size:0.85rem;margin-left:0.4rem"></span> }
        </button>
    </EditForm>
    <div class="auth-divider"><span>or</span></div>
    <a href="/register" class="auth-secondary-btn">Create new account</a>
</div>

@code {
    private LoginFormData LoginModel = new();
    private string? ErrorMessage;
    private bool Loading;
    private bool ShowPassword;

    private async Task DoLogin()
    {
        Loading = true; ErrorMessage = null;
        try
        {
            var success = await Auth.LoginAsync(LoginModel.Email, LoginModel.Password);
            if (success) { AuthStateProvider.NotifyChanged(); Nav.NavigateTo("/dashboard"); }
            else { ErrorMessage = "Invalid email or password. Please try again."; }
        }
        catch (Exception ex) { ErrorMessage = $"Login failed: {ex.Message}"; }
        finally { Loading = false; }
    }

    private sealed class LoginFormData
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = "";
    }
}
