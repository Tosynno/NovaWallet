@page "/login"
@using NovaWallet.Web.Services
@inject AuthService Auth
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Login - NovaWallet</PageTitle>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">N</div>
        <h3 class="text-center mb-1" style="color:var(--nw-primary)">NovaWallet</h3>
        <p class="text-center text-muted mb-4" style="font-size:0.9rem">Sign in to your wallet</p>
        @if (ErrorMessage is not null)
        {
            <div class="alert alert-danger mb-3">@ErrorMessage</div>
        }
        <EditForm Model="@LoginModel" FormName="customer-login" OnValidSubmit="@DoLogin">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">App Key</label>
                <InputText class="form-control" placeholder="Enter your App Key" @bind-Value="LoginModel.AppKey" />
            </div>
            <div class="mb-4">
                <label class="form-label">App Secret</label>
                <InputText type="password" class="form-control" placeholder="Enter your App Secret" @bind-Value="LoginModel.AppSecret" />
            </div>
            <button type="submit" class="btn btn-primary w-100" style="padding:0.7rem" disabled="@Loading">
                @if (Loading) { <span class="spinner"></span> <span class="ms-2">Signing in...</span> } else { <span>Sign In</span> }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginFormData LoginModel = new();
    private string? ErrorMessage;
    private bool Loading;

    private async Task DoLogin()
    {
        Loading = true; ErrorMessage = null;
        try
        {
            var success = await Auth.LoginAsync(LoginModel.AppKey, LoginModel.AppSecret);
            if (success) { AuthStateProvider.NotifyChanged(); Nav.NavigateTo("/dashboard"); }
            else { ErrorMessage = "Invalid credentials or channel not active."; }
        }
        catch (Exception ex) { ErrorMessage = $"Login failed: {ex.Message}"; }
        finally { Loading = false; }
    }

    private sealed class LoginFormData
    {
        [System.ComponentModel.DataAnnotations.Required] public string AppKey { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string AppSecret { get; set; } = "";
    }
}
