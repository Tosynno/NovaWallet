@inherits LayoutComponentBase

<div class="auth-layout">
    <div class="auth-side">
        <div class="auth-side-glow"></div>
        <div class="auth-side-content">
            <a href="/" class="auth-brand">
                <div class="auth-brand-logo">N</div>
                <span>Nova<span class="text-accent">Wallet</span></span>
            </a>
            <h2>Wallet banking,<br />reimagined.</h2>
            <p>Join thousands of Nigerians using NovaWallet for fast, secure, and affordable money transfers.</p>
            <ul class="auth-features">
                <li><span class="oi oi-check"></span> Instant transfers to any Nigerian bank</li>
                <li><span class="oi oi-check"></span> Zero hidden fees on internal transfers</li>
                <li><span class="oi oi-check"></span> Bank-grade AES-256 encryption</li>
                <li><span class="oi oi-check"></span> 24/7 transaction monitoring & reconciliation</li>
            </ul>
            <div class="auth-social-proof">
                <div class="auth-avatars">
                    <div class="auth-avatar a1">J</div>
                    <div class="auth-avatar a2">A</div>
                    <div class="auth-avatar a3">C</div>
                    <div class="auth-avatar a4">+</div>
                </div>
                <p>10,000+ users already trust NovaWallet</p>
            </div>
        </div>
    </div>
    <div class="auth-main">
        <div class="auth-main-top">
            <a href="/" class="auth-back-home"><span class="oi oi-arrow-left"></span> Back to home</a>
        </div>
        <div class="auth-card-area">
            @Body
        </div>
    </div>
</div>
