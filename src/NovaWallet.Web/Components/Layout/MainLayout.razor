@inherits LayoutComponentBase
@using NovaWallet.Web.Services
@inject AuthService Auth

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <a href="https://novawallet.ng" target="_blank" class="text-decoration-none">NovaWallet</a>
            @if (Auth.IsAuthenticated)
            {
                <span class="text-muted small">@Auth.ChannelKey</span>
                <a href="/login" class="btn btn-outline-secondary btn-sm" @onclick="@(() => { Auth.Logout(); })">Logout</a>
            }
            else
            {
                <a href="/login" class="btn btn-primary btn-sm">Login</a>
            }
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" class="blazor-error-ui" style="display:none">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
