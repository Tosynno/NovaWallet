@inherits LayoutComponentBase
@using NovaWallet.Web.Services
@inject AuthService Auth
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="wallet-app">
    <aside class="wallet-sidebar">
        <a href="/dashboard" class="wallet-sidebar-brand">
            <div class="wallet-brand-logo">N</div>
            <span>Nova<span class="text-accent">Wallet</span></span>
        </a>
        <nav class="wallet-nav">
            <a class="wallet-nav-link @(CurrentPage == "dashboard" ? "active" : "")" href="/dashboard"><span class="oi oi-home"></span> Home</a>
            <a class="wallet-nav-link @(CurrentPage == "transfer" ? "active" : "")" href="/transfer"><span class="oi oi-transfer"></span> Transfer</a>
            <a class="wallet-nav-link @(CurrentPage == "statement" ? "active" : "")" href="/statement"><span class="oi oi-list"></span> History</a>
            <a class="wallet-nav-link @(CurrentPage == "kyc" ? "active" : "")" href="/kyc"><span class="oi oi-shield"></span> KYC</a>
        </nav>
        <div class="wallet-sidebar-footer">
            @if (Auth.IsAuthenticated)
            {
                <div class="wallet-user-box">
                    <div class="wallet-user-avatar">@(GetInitials())</div>
                    <div class="wallet-user-info">
                        <p class="wallet-user-name">@(Auth.CustomerId ?? "User")</p>
                        <p class="wallet-user-status"><span class="status-dot"></span> Active</p>
                    </div>
                </div>
                <button class="wallet-logout-btn" @onclick="DoLogout">
                    <span class="oi oi-account-logout"></span> Logout
                </button>
            }
            else
            {
                <a href="/login" class="wallet-login-btn"><span class="oi oi-account-login me-1"></span> Sign In</a>
            }
        </div>
    </aside>
    <main class="wallet-main">
        <div class="wallet-main-inner">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" class="blazor-error-ui" style="display:none">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">X</a>
</div>

@code {
    private string CurrentPage => Nav.Uri.Split('/').LastOrDefault()?.Split('?').FirstOrDefault() ?? "";

    private string GetInitials()
    {
        var name = Auth.CustomerId ?? "U";
        if (name.Length >= 2) return name[..2].ToUpperInvariant();
        return name.ToUpperInvariant();
    }

    private void DoLogout()
    {
        Auth.Logout();
        AuthStateProvider.NotifyChanged();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
